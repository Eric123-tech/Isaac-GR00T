+
+from isaaclab.app import AppLauncher
+
+
+
+app_launcher = AppLauncher(headless=True)
+
+simulation_app = app_launcher.app
+
+
+
+import torch
+
+
+
+import isaaclab.sim as sim_utils
+
+from isaaclab.assets import Articulation, ArticulationCfg
+
+from isaaclab.actuators import ImplicitActuatorCfg
+
+
+
+
+
+LH_USD = "/mnt/data/haoyu_data/isaaclab_assets/artimano/lh_mano.usd"
+
+RH_USD = "/mnt/data/haoyu_data/isaaclab_assets/artimano/rh_mano.usd"
+
+
+
+
+
+EXPECTED_ORDER = [
+
+    "j_index1y",
+
+    "j_index1z",
+
+    "j_index2",
+
+    "j_index3",
+
+    "j_middle1y",
+
+    "j_middle1z",
+
+    "j_middle2",
+
+    "j_middle3",
+
+    "j_pinky1y",
+
+    "j_pinky1z",
+
+    "j_pinky2",
+
+    "j_pinky3",
+
+    "j_ring1y",
+
+    "j_ring1z",
+
+    "j_ring2",
+
+    "j_ring3",
+
+    "j_thumb1x",
+
+    "j_thumb1y",
+
+    "j_thumb1z",
+
+    "j_thumb2y",
+
+    "j_thumb2z",
+
+    "j_thumb3",
+
+]
+
+
+
+
+
+def make_hand_cfg(prim_path: str, usd_path: str) -> ArticulationCfg:
+
+    return ArticulationCfg(
+
+        prim_path=prim_path,
+
+        spawn=sim_utils.UsdFileCfg(
+
+            usd_path=usd_path,
+
+            rigid_props=sim_utils.RigidBodyPropertiesCfg(
+
+                disable_gravity=True,
+
+                retain_accelerations=False,
+
+                linear_damping=0.05,
+
+                angular_damping=0.05,
+
+                max_linear_velocity=1000.0,
+
+                max_angular_velocity=1000.0,
+
+                max_depenetration_velocity=1.0,
+
+            ),
+
+            articulation_props=sim_utils.ArticulationRootPropertiesCfg(
+
+                enabled_self_collisions=False,
+
+                solver_position_iteration_count=8,
+
+                solver_velocity_iteration_count=0,
+
+            ),
+
+        ),
+
+        init_state=ArticulationCfg.InitialStateCfg(
+
+            pos=(0.0, 0.0, 1.0),
+
+            rot=(1.0, 0.0, 0.0, 0.0),
+
+        ),
+
+        actuators={
+
+            "all_joints": ImplicitActuatorCfg(
+
+                joint_names_expr=[".*"],
+
+                stiffness=5.0,
+
+                damping=0.1,
+
+            ),
+
+        },
+
+    )
+
+
+
+
+
+def print_robot_info(name: str, robot: Articulation):
+
+    print(f"\n===== {name} =====")
+
+    print("num_joints:", robot.num_joints)
+
+    print("joint_names:")
+
+    for i, n in enumerate(robot.joint_names):
+
+        print(f"{i:02d}: {n}")
+
+
+
+    print("\nsoft_joint_pos_limits shape:", tuple(robot.data.soft_joint_pos_limits.shape))
+
+    limits = robot.data.soft_joint_pos_limits[0].detach().cpu()
+
+    for i, n in enumerate(robot.joint_names):
+
+        lo, hi = limits[i].tolist()
+
+        print(f"{i:02d}: {n:12s} lower={lo:.6f} upper={hi:.6f}")
+
+
+
+    if robot.joint_names == EXPECTED_ORDER:
+
+        print("ORDER_CHECK: MATCH")
+
+    else:
+
+        print("ORDER_CHECK: MISMATCH")
+
+        print("expected:")
+
+        for i, n in enumerate(EXPECTED_ORDER):
+
+            print(f"{i:02d}: {n}")
+
+
+
+
+
+def main():
+
+    sim_cfg = sim_utils.SimulationCfg(dt=1.0 / 60.0, device="cuda:0")
+
+    sim = sim_utils.SimulationContext(sim_cfg)
+
+    sim.set_camera_view([1.5, 1.5, 1.5], [0.0, 0.0, 0.7])
+
+
+
+    ground_cfg = sim_utils.GroundPlaneCfg()
+
+    ground_cfg.func("/World/defaultGroundPlane", ground_cfg)
+
+
+
+    light_cfg = sim_utils.DomeLightCfg(intensity=1000.0)
+
+    light_cfg.func("/World/Light", light_cfg)
+
+
+
+    lh = Articulation(make_hand_cfg("/World/LH", LH_USD))
+
+    rh_cfg = make_hand_cfg("/World/RH", RH_USD)
+
+    rh_cfg.init_state.pos = (0.3, 0.0, 1.0)
+
+    rh = Articulation(rh_cfg)
+
+
+
+    sim.reset()
+
+    print("[INFO] Simulation reset complete.")
+
+
+
+    lh.update(sim.get_physics_dt())
+
+    rh.update(sim.get_physics_dt())
+
+
+
+    print_robot_info("LH", lh)
+
+    print_robot_info("RH", rh)
+
+
+
+    # Try one safe position target: middle of joint limits.
+
+    for robot in [lh, rh]:
+
+        limits = robot.data.soft_joint_pos_limits[0]
+
+        target = 0.5 * (limits[:, 0] + limits[:, 1])
+
+        robot.set_joint_position_target(target.unsqueeze(0))
+
+        robot.write_data_to_sim()
+
+
+
+    for _ in range(20):
+
+        sim.step()
+
+        lh.update(sim.get_physics_dt())
+
+        rh.update(sim.get_physics_dt())
+
+
+
+    print("\n[INFO] Artimano USD load + joint target test OK.")
+
+    simulation_app.close()
+
+
+
+
+
+if __name__ == "__main__":
+
+    main()
+
